<h1>Posters</h1>

<div class="row">
  <% @posters.each do |poster| %>
    <div class="col-md-4 mb-3">
      <div class="card">
        <% if poster.image.attached? %>
          <%= link_to poster_path(poster) do %>
            <%= image_tag url_for(poster.image.variant(resize_to_limit: [400, 300])), class: "card-img-top" %>
          <% end %>
        <% end %>
        <div class="card-body">
          <h5 class="card-title"><%= link_to poster.title, poster %></h5>
          <p class="card-text"><%= truncate(poster.description, length: 120) %></p>
        </div>
      </div>
    </div>
  <% end %>
</div>

<%= link_to "New Poster", new_poster_path, class: "btn btn-primary mt-3" %>