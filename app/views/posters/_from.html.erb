<%= bootstrap_form_with(model: poster, local: true, html: { multipart: true }) do |f| %>
  <%= f.text_field :title, required: true %>
  <%= f.text_area :description, rows: 5 %>

  <div class="form-group">
    <%= f.label :image, "Poster image" %>
    <%= f.file_field :image, class: "form-control-file" %>

    <% if poster&.image&.attached? %>
      <div class="mt-2">
        <%= image_tag url_for(poster.image.variant(resize_to_limit: [400, 300])), class: "img-thumbnail" %>
      </div>
    <% end %>
  </div>

  <%= f.hidden_field :user_id, value: current_user&.id %>
  <%= f.submit class: "btn btn-primary" %>
<% end %>