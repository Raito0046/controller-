<h1>Reviews for <%= @movie.title %></h1>

<%= link_to "New Review", new_movie_review_path(@movie) %> |
<%= link_to "Back to Movies", movies_path %>

<ul>
  <% @reviews.each do |review| %>
    <li>
      <%= link_to review.title, movie_review_path(@movie, review) %>
      (<%= link_to "Edit", edit_movie_review_path(@movie, review) %>,
       <%= link_to "Delete", movie_review_path(@movie, review), method: :delete, data: { confirm: "Are you sure?" } %>)
    </li>
  <% end %>
</ul>
